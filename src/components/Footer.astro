---
import { CONTACTO, WHATSAPP_NUMBER } from '../data/contenido';
const BASE = import.meta.env.BASE_URL;
const wa = `https://wa.me/${WHATSAPP_NUMBER}`;
const instagram = 'https://www.instagram.com/newcom.escuela18desep.puq/';
const facebook = 'https://web.facebook.com/people/Club-Deportivo-Newcom-18-de-Septiembre/61572076650262/';
const anio = new Date().getFullYear();
---

<!-- ====== FOOTER con imagen AVIF + overlay ====== -->
<footer class="cierre" id="contacto" aria-labelledby="tit-cierre">
  <div class="cierre-fondo" style={`background-image:url('${BASE}img/fondo-footer-newcom-punta-arenas.avif')`} aria-hidden="true"></div>
  <div class="contenedor">
    <p class="kicker-mod" style="color:var(--oro)">Punta Arenas, Patagonia, siempre más</p>
    <h2 id="tit-cierre" style="margin-top:12px">Más personas, <span>más vida.</span></h2>
    <p class="cierre-lead" style="max-width:52ch;color:#CFE0F1;margin-top:12px">Juntos seguimos sumando. Ven a entrenar, compartir y disfrutar: el Newcom nos une y acá te esperamos con los brazos abiertos.</p>
    <div class="cierre-ctas">
      <a class="cta" href="#inscripcion"><svg class="cta-pelota" aria-hidden="true"><use href="#pelota"/></svg> Probar una clase</a>
      <a class="btn-wa" href={wa}><svg style="width:22px;height:22px" aria-hidden="true"><use href="#wa"/></svg> Hablar por WhatsApp</a>
    </div>
    <div class="contacto-layout rev">
      <div class="contacto-info">
        <h3 class="contacto-tit">Contacto directo</h3>
        <p class="contacto-bajada">Prefieres llamar o escribir por tu cuenta, aquí tienes todos los canales del club.</p>
    <div class="contacto-grid">
      <div class="contacto-card"><h3><svg aria-hidden="true"><use href="#tel"/></svg> WhatsApp y llamadas</h3>
        <a href={wa}><svg class="mini" aria-hidden="true"><use href="#wa"/></svg> <span>{CONTACTO.telefonos[0]}</span></a>
        <a href="tel:+56996405463"><svg class="mini" aria-hidden="true"><use href="#tel"/></svg> <span>{CONTACTO.telefonos[1]}</span></a>
      </div>
      <div class="contacto-card"><h3><svg aria-hidden="true"><use href="#mail"/></svg> Correo</h3>
        <a href={`mailto:${CONTACTO.email}`}><svg class="mini" aria-hidden="true"><use href="#mail"/></svg> <span>{CONTACTO.email}</span></a>
        <a href="#donde"><svg class="mini" aria-hidden="true"><use href="#cal"/></svg> Ver horarios de entrenamiento</a>
      </div>
      <div class="contacto-card"><h3><svg aria-hidden="true"><use href="#corazon"/></svg> Redes y legal</h3>
        <a href={facebook} target="_blank" rel="noopener"><svg class="mini" aria-hidden="true"><use href="#fb"/></svg> Facebook del club</a>
        <a href={instagram} target="_blank" rel="noopener"><svg class="mini" aria-hidden="true"><use href="#ig"/></svg> @newcom.escuela18desep.puq</a>
        <button class="link-claro" data-modal="privacidad"><svg class="mini" aria-hidden="true"><use href="#check"/></svg> Política de Privacidad</button>
        <button class="link-claro" data-modal="terminos"><svg class="mini" aria-hidden="true"><use href="#check"/></svg> Términos de Uso</button>
        <button class="link-claro" data-modal="accesibilidad"><svg class="mini" aria-hidden="true"><use href="#acc"/></svg> Declaración de accesibilidad</button>
      </div>
    </div>
      </div>
    <div class="contacto-form">
      <form class="form-tarjeta" id="formContacto" novalidate>
        <h3>Escríbenos por correo</h3>
        <p style="color:var(--tinta-suave);margin-bottom:20px">¿Dudas, prensa o quieres apoyar al club? Te respondemos a la brevedad a tu correo.</p>
        <div class="campo" id="ccNombre">
          <label for="cNombre">Tu nombre *</label>
          <input type="text" id="cNombre" name="nombre" autocomplete="name" required aria-describedby="err-c-nombre" />
          <p class="error-campo" id="err-c-nombre">Por favor escribe tu nombre (mínimo 2 letras).</p>
        </div>
        <div class="campo" id="ccEmail">
          <label for="cEmail">Tu correo *</label>
          <input type="email" id="cEmail" name="email" autocomplete="email" placeholder="tucorreo@ejemplo.cl" required aria-describedby="err-c-email" />
          <p class="error-campo" id="err-c-email">Escribe un correo válido para poder responderte.</p>
        </div>
        <div class="campo" id="ccTel">
          <label for="cTel">Teléfono <small>(opcional)</small></label>
          <input type="tel" id="cTel" name="telefono" autocomplete="tel-national" inputmode="tel" placeholder="+569 1234 5678" aria-describedby="err-c-tel" />
          <p class="error-campo" id="err-c-tel">Revisa el número (solo dígitos, mínimo 7).</p>
        </div>
        <div class="campo" id="ccMensaje">
          <label for="cMensaje">Tu mensaje *</label>
          <textarea id="cMensaje" name="mensaje" placeholder="Cuéntanos en qué te ayudamos..." required aria-describedby="err-c-mensaje"></textarea>
          <p class="error-campo" id="err-c-mensaje">Escribe tu mensaje (mínimo 5 caracteres).</p>
        </div>
        <div class="campo" id="ccConsent">
          <label class="consent"><input type="checkbox" id="cConsent" required /> <span>He leído y acepto la <a href="#" data-modal="privacidad">Política de Privacidad</a> y autorizo el tratamiento de mis datos para responder mi mensaje. *</span></label>
          <p class="error-campo" id="err-c-consent">Debes aceptar la Política de Privacidad para continuar.</p>
        </div>
        <input class="honey" type="text" name="empresa" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="cta" id="btnContacto" style="width:100%"><svg class="cta-pelota" aria-hidden="true"><use href="#mail"/></svg> Enviar mensaje</button>
        <p class="form-msg" id="msgContacto" aria-live="polite"></p>
      </form>
    </div>
    </div>
    <div class="footer-fin">
      <a class="badge-fractal" href="https://fractalhost.cl" target="_blank" rel="noopener"><span class="f-dot" aria-hidden="true"></span> Sitio web desarrollado por Fractal Host</a>
      <p class="footer-copy">© <span id="anioFooter">{anio}</span> Club Deportivo Newcom Escuela 18 de Septiembre · Punta Arenas, Magallanes</p>
      <p class="fractal-nota">Fractal Host es auspiciador del Club Deportivo Newcom Escuela 18 de Septiembre.</p>
    </div>
  </div>
</footer>
